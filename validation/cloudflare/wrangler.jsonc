{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tonghuashun-tick",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SCHEDULER_MODE": "active"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
