# Local only; use a secret manager in deployment. Never commit populated values.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8080
PRODUCT_HOST=127.0.0.1
PRODUCT_PORT=8080
PRODUCT_DB_PATH=.product-data/monitor.sqlite
DEMO_PASSWORD=
SESSION_SECRET=
TICK_SECRET=
# Optional: natural language. Model always deepseek-flash.
DEEPSEEK_API_KEY=
# Missing/unverified market data remains unavailable.
FUYAO_API_KEY=
